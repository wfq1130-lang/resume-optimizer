# DeepSeek API Key
DEEPSEEK_API_KEY=your_api_key_here
# Flask secret key (shared by frontend and backend)
SECRET_KEY=change-me-to-random-string
# JWT Secret (must match on frontend and backend)
JWT_SECRET=shared-jwt-secret-for-both-services
# Teacher registration code (for admin)
TEACHER_CODE=admin123
# Backend API URL (for frontend to call backend internally)
BACKEND_URL=http://127.0.0.1:5002
# Backend port
BACKEND_PORT=5002
