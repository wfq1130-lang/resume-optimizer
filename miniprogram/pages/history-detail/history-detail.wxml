<view class="container">
  <view wx:if="{{error}}" class="empty-state">
    <view>{{error}}</view>
  </view>

  <view wx:if="{{data.id}}">
    <view class="card">
      <view class="score-circle">
        <text class="score-number">{{data.overall_score || '--'}}</text>
        <text class="score-label">综合得分</text>
      </view>
      <view class="score-grid" wx:if="{{scores.length}}">
        <view class="score-item" wx:for="{{scores}}" wx:key="name">
          <text class="score-item-name">{{item.name}}</text>
          <text class="score-item-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{data.optimized_resume}}">
      <view class="card-title">优化后的简历</view>
      <view style="white-space:pre-wrap;font-size:28rpx;line-height:1.8;background:var(--bg);padding:24rpx;border-radius:var(--radius)">{{data.optimized_resume}}</view>
    </view>

    <view class="card" wx:if="{{suggestions.length}}">
      <view class="card-title">改进建议</view>
      <view class="tips-list">
        <view class="tips-list-item" wx:for="{{suggestions}}" wx:key="*this">{{index + 1}}. {{item}}</view>
      </view>
    </view>
  </view>
</view>
