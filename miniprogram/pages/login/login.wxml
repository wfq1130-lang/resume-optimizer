<view class="container">
  <view class="card">
    <view class="card-title">微信登录</view>
    <view style="text-align:center;margin-bottom:24rpx;color:var(--text-muted);font-size:28rpx">
      使用微信一键登录，保护你的隐私
    </view>
    <button class="btn btn-primary" bind:tap="wxLogin" loading="{{loading}}" disabled="{{loading}}">
      {{loading ? '登录中...' : '微信一键登录'}}
    </button>
    <view wx:if="{{error}}" class="error-msg" style="text-align:center;margin-top:16rpx">{{error}}</view>
  </view>

  <view class="card" wx:if="{{userInfo}}">
    <view class="card-title">绑定信息 (选填)</view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="绑定后可通过手机号登录网页版" value="{{phone}}" bind:input="onPhoneInput" />
    </view>
    <view class="form-group">
      <text class="form-label">邮箱</text>
      <input class="form-input" type="text" placeholder="绑定后可通过邮箱登录网页版" value="{{email}}" bind:input="onEmailInput" />
    </view>
    <button class="btn btn-outline" bind:tap="bindInfo">保存绑定信息</button>
    <view wx:if="{{bindMsg}}" class="{{bindOk?'success-msg':'error-msg'}}" style="text-align:center;margin-top:16rpx">{{bindMsg}}</view>
  </view>
</view>
