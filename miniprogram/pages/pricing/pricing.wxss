.plan-card {
  border: 2rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.plan-header {
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.plan-price {
  font-size: 64rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.plan-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-muted);
}

.plan-features {
  margin-bottom: 24rpx;
}

.plan-features view {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 2;
}

.payment-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.payment-modal {
  background: #fff;
  border-radius: var(--radius);
  padding: 48rpx;
  margin: 48rpx;
  text-align: center;
}
